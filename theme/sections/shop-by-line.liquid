{%- doc -%}
  Shop by Line: a row of tiles linking to a collection filtered by product-line tag
  (e.g. Comfort Line, Race Line). Uses Shopify's native /collections/{handle}/{tag}
  URL filtering, so no extra collections need to be created.
{%- enddoc -%}

{%- comment -%}
  On a collection page, only render when viewing the collection this section's
  tiles actually point into (e.g. don't show cycling-line tiles on the fitness
  collection page). On the homepage (or anywhere collection is undefined),
  always render.
{%- endcomment -%}
{%- if collection == blank or collection.handle == section.settings.target_collection_handle -%}
<div
  class="shop-by-line color-{{ section.settings.color_scheme }}"
  style="
    --sbl-padding-block-start: {{ section.settings.padding-block-start }}px;
    --sbl-padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="shop-by-line__inner page-width{% if section.settings.section_width == 'full-width' %} shop-by-line__inner--full{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="shop-by-line__heading">{{ section.settings.heading }}</div>
    {%- endif -%}

    <div class="shop-by-line__row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'line_tile' -%}
          {%- liquid
            assign tag_handle = block.settings.tag | handleize
            assign tile_url = '/collections/' | append: section.settings.target_collection_handle | append: '/' | append: tag_handle

            assign tile_count = 0
            if section.settings.target_collection_handle != blank and block.settings.tag != blank
              assign target_collection = collections[section.settings.target_collection_handle]
              for product in target_collection.products
                if product.tags contains block.settings.tag
                  assign tile_count = tile_count | plus: 1
                endif
              endfor
            endif
          -%}
          <a
            href="{{ tile_url }}"
            class="shop-by-line__tile"
            {{ block.shopify_attributes }}
          >
            <span class="shop-by-line__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800',
                    sizes: '(min-width: 750px) 20vw, 60vw',
                    class: 'shop-by-line__image'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'shop-by-line__image placeholder' }}
              {%- endif -%}
            </span>
            <span class="shop-by-line__label">
              {{ block.settings.label }}
              {%- if tile_count > 0 -%}
                <span class="shop-by-line__count">{{ tile_count }} 件商品</span>
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

<style>
  .shop-by-line {
    padding-block-start: var(--sbl-padding-block-start, 48px);
    padding-block-end: var(--sbl-padding-block-end, 48px);
  }

  .shop-by-line__inner--full {
    max-width: none;
    padding-inline: 24px;
  }

  .shop-by-line__heading {
    margin-block-end: 20px;
  }

  .shop-by-line__row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    padding-block-end: 4px;
  }

  .shop-by-line__tile {
    flex: 0 0 auto;
    width: clamp(140px, 20vw, 220px);
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .shop-by-line__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-background, #f2f2f2);
  }

  .shop-by-line__image,
  .shop-by-line__media .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .shop-by-line__tile:hover .shop-by-line__image {
    transform: scale(1.06);
  }

  .shop-by-line__label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-block-start: 10px;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
  }

  .shop-by-line__count {
    font-size: 0.8rem;
    font-weight: 400;
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .shop-by-line__tile {
      width: clamp(120px, 42vw, 170px);
    }
  }
</style>

{% schema %}
{
  "name": "Shop by line",
  "class": "shop-by-line-section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>自行車系列 · 依款式選購</h2>"
    },
    {
      "type": "text",
      "id": "target_collection_handle",
      "label": "Collection handle to filter",
      "info": "The collection each tile's tag-filter link points into, e.g. chiba-gloves-germany",
      "default": "chiba-gloves-germany"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "line_tile",
      "name": "Line tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Display label",
          "default": "Comfort Line"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Exact product tag",
          "info": "Must match the product tag exactly, e.g. \"Comfort Line\"",
          "default": "Comfort Line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by line",
      "blocks": [
        { "type": "line_tile", "settings": { "label": "舒適系列", "tag": "Comfort Line" } },
        { "type": "line_tile", "settings": { "label": "運動系列", "tag": "Active Line" } },
        { "type": "line_tile", "settings": { "label": "BioXCell 減壓系列", "tag": "BioXCell Line" } },
        { "type": "line_tile", "settings": { "label": "競速系列", "tag": "Race Line" } },
        { "type": "line_tile", "settings": { "label": "全能系列", "tag": "Allround Line" } }
      ]
    }
  ]
}
{% endschema %}
