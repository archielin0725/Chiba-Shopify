{%- comment -%}
  BioXCell® Technology Spotlight Section
  High-impact technical breakdown of Chiba's proprietary ergonomic innovations:
  BioXCell 2-phase gel, Poron XRD shock absorption, Quick-Pull system.
  Compliant terminology: Fully neutral ergonomic engineering standards.
{%- endcomment -%}

<style>
  .tech-spotlight-{{ section.id }} {
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color | default: '#090d16' }};
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .tech-spotlight-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: -50%;
    left: 50%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.12) 0%, rgba(14, 165, 233, 0) 70%);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .tech-spotlight-container {
    max-width: var(--normal-page-width, 120rem);
    margin-inline: auto;
    padding-inline: max(1.5rem, 5vw);
    position: relative;
    z-index: 1;
  }

  .tech-spotlight-header {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  .tech-spotlight-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #38bdf8;
    background: rgba(14, 165, 233, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 999px;
    padding: 4px 14px;
    margin-bottom: 1rem;
  }

  .tech-spotlight-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .tech-spotlight-subtitle {
    font-size: 1.0625rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.65;
  }

  .tech-spotlight-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .tech-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    backdrop-filter: blur(12px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .tech-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35), 0 0 20px rgba(14, 165, 233, 0.15);
  }

  .tech-card__badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 4px;
    padding: 3px 8px;
    margin-bottom: 1.25rem;
  }

  .tech-card__icon {
    font-size: 2.25rem;
    margin-bottom: 1.25rem;
    line-height: 1;
  }

  .tech-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.75rem;
    line-height: 1.35;
  }

  .tech-card__desc {
    font-size: 0.9375rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }

  .tech-spotlight-cta {
    text-align: center;
  }

  .tech-spotlight-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: #0ea5e9;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 16px rgba(14, 165, 233, 0.3);
  }

  .tech-spotlight-button:hover {
    background: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(14, 165, 233, 0.45);
  }

  @media screen and (max-width: 900px) {
    .tech-spotlight-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .tech-card {
      padding: 1.75rem 1.5rem;
    }

    .tech-spotlight-header {
      margin-bottom: 2.5rem;
    }
  }
</style>

<div class="tech-spotlight-{{ section.id }}">
  <div class="tech-spotlight-container">
    <div class="tech-spotlight-header">
      <span class="tech-spotlight-eyebrow">GERMAN ERGONOMIC SYSTEM</span>
      <h2 class="tech-spotlight-title">
        {%- if localization.language.iso_code == 'en' -%}BioXCell® Two-Stage Ergonomic Cushioning System{%- else -%}BioXCell® 人體工學雙階減壓系統{%- endif -%}
      </h2>
      <p class="tech-spotlight-subtitle">
        {%- if localization.language.iso_code == 'en' -%}
          Designed to relieve hand numbness and vibration pressure. Developed by a German ergonomic research team to protect every ride and high-intensity grip.
        {%- else -%}
          專為緩解手麻與震動壓迫而生。由德國百年人體工學研發團隊精心打造，為每一次騎乘與高強度抓握提供極致保護。
        {%- endif -%}
      </p>
    </div>

    <div class="tech-spotlight-grid">
      <!-- Card 1 -->
      <div class="tech-card">
        <span class="tech-card__badge">{% if localization.language.iso_code == 'en' %}European Ergonomic Certification{% else %}歐洲人體工學認證{% endif %}</span>
        <div class="tech-card__icon" aria-hidden="true">🧬</div>
        <h3 class="tech-card__title">{% if localization.language.iso_code == 'en' %}BioXCell Two-Stage Shock-Absorbing Gel{% else %}BioXCell 雙階避震凝膠{% endif %}</h3>
        <p class="tech-card__desc">
          {% if localization.language.iso_code == 'en' %}Precisely positioned away from the ulnar and median nerve pathways, the stepped dual-layer gel pad disperses handlebar vibration to help prevent numb fingers and grip fatigue on long rides.{% else %}精確避開掌面尺神經與正中神經通道，階梯式雙層凝膠墊有效分散車把微幅震盪，徹底防止長途騎乘所產生的手指麻痺與握力疲乏。{% endif %}
        </p>
      </div>

      <!-- Card 2 -->
      <div class="tech-card">
        <span class="tech-card__badge" style="color: #f59e0b; background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.2);">{% if localization.language.iso_code == 'en' %}90% Impact Absorption{% else %}90% 衝擊吸收{% endif %}</span>
        <div class="tech-card__icon" aria-hidden="true">⚡</div>
        <h3 class="tech-card__title">{% if localization.language.iso_code == 'en' %}Poron® XRD Advanced Impact Protection{% else %}Poron® XRD 極致吸震核心{% endif %}</h3>
        <p class="tech-card__desc">
          {% if localization.language.iso_code == 'en' %}Soft and breathable in everyday use, the material conforms to the palm and hardens in an instant on impact, absorbing up to 90% of impact energy to protect the metacarpal bones.{% else %}常態下柔軟透氣貼合掌形，遭遇劇烈衝擊瞬間分子連鎖硬化，瞬間吸收高達 90% 衝擊能量，為掌骨提供最堅固的無形防護。{% endif %}
        </p>
      </div>

      <!-- Card 3 -->
      <div class="tech-card">
        <span class="tech-card__badge" style="color: #10b981; background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2);">{% if localization.language.iso_code == 'en' %}Quick-Release Design{% else %}快拆結構{% endif %}</span>
        <div class="tech-card__icon" aria-hidden="true">🧲</div>
        <h3 class="tech-card__title">{% if localization.language.iso_code == 'en' %}Quick-Pull Release Loop{% else %}Quick-Pull 快速脫手拉環{% endif %}</h3>
        <p class="tech-card__desc">
          {% if localization.language.iso_code == 'en' %}A classic Chiba design. After intense exercise, slip two fingers through the loop between the middle and ring fingers to remove the gloves quickly without pulling the seams.{% else %}Chiba 經典設計。高強度運動大量出汗後，只需以雙指穿入中指與無名指間的拉環，即可一秒俐落脫卸手套，保護縫線不拉扯。{% endif %}
        </p>
      </div>
    </div>

    <div class="tech-spotlight-cta">
      <a href="{{ routes.all_products_collection_url }}/bioxcell-line" class="tech-spotlight-button">
        {% if localization.language.iso_code == 'en' %}Explore BioXCell Cushioning{% else %}探索 BioXCell 減壓系列{% endif %} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BioXCell 人體工學科技專題",
  "class": "section-technology-spotlight",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "背景顏色",
      "default": "#090d16"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上方間距",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下方間距",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "BioXCell 人體工學科技專題"
    }
  ]
}
{% endschema %}
