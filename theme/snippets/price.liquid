{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block,featured product block, and the product card block.

  @param {product} product_resource - The product to render
  @param {boolean} [show_unit_price] - Whether to show the unit price
  @param {boolean} [show_sale_price_first] - Whether to show the sale price first
{%- enddoc -%}

{% render 'price-styles' %}

{%- liquid
  assign show_unit_price = show_unit_price | default: false
  assign show_sale_price_first = show_sale_price_first | default: false
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_at_price = selected_variant.compare_at_price

  assign show_compare_price = false
  if compare_at_price > price
    assign show_compare_price = true
  endif

  if product_resource == blank
    assign price = 1999
  endif

  # Check if variant has volume pricing
  assign has_volume_pricing = null
  assign price_min = null
  assign price_max = null

  # For product cards (collection/search pages), calculate min/max across all variants
  # For product pages, only use the selected variant's pricing
  assign is_product_card = false
  if template.name != 'product'
    assign is_product_card = true
  endif

  if is_product_card
    assign price_min = product_resource.price_min
    assign price_max = product_resource.price_max
    assign has_volume_pricing = product_resource.quantity_price_breaks_configured? | default: false
  else
    # Product page: only use selected variant's pricing
    if selected_variant.quantity_price_breaks.size > 0
      assign has_volume_pricing = true
      assign price_min = selected_variant.quantity_price_breaks.last.price
      assign price_max = selected_variant.price
    endif
  endif

  # Determine if currency code should be shown
  assign use_currency = false
  if product.handle == product_resource.handle
    if settings.currency_code_enabled_product_pages
      assign use_currency = true
    endif
  elsif settings.currency_code_enabled_product_cards
    assign use_currency = true
  endif

  # Format all prices ensuring official Taiwan format: NT$ X,XXX
  assign raw_price = price | money_without_trailing_zeros | remove: ' TWD' | remove: 'TWD' | strip
  if raw_price contains 'NT$'
    assign price = raw_price | replace: 'NT$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
  elsif raw_price contains '$'
    assign price = raw_price | replace: '$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
  else
    assign price = 'NT$ ' | append: raw_price
  endif

  if compare_at_price > 0
    assign raw_compare = compare_at_price | money_without_trailing_zeros | remove: ' TWD' | remove: 'TWD' | strip
    if raw_compare contains 'NT$'
      assign compare_at_price = raw_compare | replace: 'NT$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
    elsif raw_compare contains '$'
      assign compare_at_price = raw_compare | replace: '$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
    else
      assign compare_at_price = 'NT$ ' | append: raw_compare
    endif
  endif

  if price_min != null
    assign raw_min = price_min | money_without_trailing_zeros | remove: ' TWD' | remove: 'TWD' | strip
    if raw_min contains 'NT$'
      assign price_min = raw_min | replace: 'NT$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
    elsif raw_min contains '$'
      assign price_min = raw_min | replace: '$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
    else
      assign price_min = 'NT$ ' | append: raw_min
    endif

    assign raw_max = price_max | money_without_trailing_zeros | remove: ' TWD' | remove: 'TWD' | strip
    if raw_max contains 'NT$'
      assign price_max = raw_max | replace: 'NT$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
    elsif raw_max contains '$'
      assign price_max = raw_max | replace: '$', 'NT$ ' | replace: 'NT$  ', 'NT$ '
    else
      assign price_max = 'NT$ ' | append: raw_max
    endif
  endif
-%}

<div ref="priceContainer">
  {% if has_volume_pricing %}
    {% comment %} Volume pricing display {% endcomment %}
    {% if show_compare_price %}
      <span class="price-item__group compare-at-price">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        <bdi>{{- compare_at_price -}}</bdi>
      </span>
    {% endif %}
    <span class="price-item__group price">
      <span class="visually-hidden">{{ 'content.price_range' | t }}&nbsp;</span>
      <bdi>{{ price_min }} - {{ price_max }}</bdi>
    </span>
  {% else %}
    {% comment %} Standard pricing display: render only the active branch (regular or sale) {% endcomment %}
    {% if show_compare_price %}
      {% if show_sale_price_first %}
        <span class="price-item__group price">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <bdi>{{ price | default: '&nbsp;' }}</bdi>
        </span>
        <span class="price-item__group price-item--regular compare-at-price">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <bdi>{{- compare_at_price -}}</bdi>
        </span>
      {% else %}
        <span class="price-item__group price-item--regular compare-at-price">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <bdi>{{- compare_at_price -}}</bdi>
        </span>
        <span class="price-item__group price">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <bdi>{{ price | default: '&nbsp;' }}</bdi>
        </span>
      {% endif %}
    {% else %}
      <span class="price"
        ><span class="price-prefix">{{ 'content.price_regular' | t }}</span><bdi>{{ price | default: '&nbsp;' }}</bdi></span
      >
    {% endif %}
  {% endif %}
  {%- if selected_variant.unit_price and show_unit_price %}
    {%- liquid
      if use_currency
        assign unit_price = selected_variant.unit_price | money_with_currency
      else
        assign unit_price = selected_variant.unit_price | money
      endif
    -%}
    {% render 'unit-price', price: unit_price, measurement: selected_variant.unit_price_measurement %}
  {%- endif -%}
</div>
{%- if has_volume_pricing -%}
  <small
    ref="volumePricingNote"
    class="volume-pricing-note"
  >
    {{- 'content.volume_pricing_available' | t -}}
  </small>
{%- endif -%}
