{%- doc -%}
  Renders breadcrumbs navigation for collection and product pages.
{%- enddoc -%}

{%- if template.name == 'collection' or template.name == 'product' -%}
{%- liquid
  assign breadcrumb_home = '首頁'
  assign breadcrumb_cycling = '自行車系列'
  assign breadcrumb_fitness = '健身系列'
  assign breadcrumb_bioxcell = 'BioXCell 減壓系列'
  assign breadcrumb_comfort = 'Comfort 舒適系列'
  assign breadcrumb_active = 'Active 活力系列'
  assign breadcrumb_race = 'Race 競速系列'
  assign breadcrumb_supports = '護腕護膝與護肘'
  assign breadcrumb_belts = '重訓與健力腰帶'
  assign breadcrumb_gloves = '重訓手套'
  assign breadcrumb_all = '全部商品'
  if localization.language.iso_code == 'en'
    assign breadcrumb_home = 'Home'
    assign breadcrumb_cycling = 'Cycling'
    assign breadcrumb_fitness = 'Fitness'
    assign breadcrumb_bioxcell = 'BioXCell Cushioning'
    assign breadcrumb_comfort = 'Comfort'
    assign breadcrumb_active = 'Active'
    assign breadcrumb_race = 'Race'
    assign breadcrumb_supports = 'Wrist, Knee and Elbow Supports'
    assign breadcrumb_belts = 'Training and Powerlifting Belts'
    assign breadcrumb_gloves = 'Training Gloves'
    assign breadcrumb_all = 'All Products'
  endif
-%}
<nav class="chiba-breadcrumbs page-width" aria-label="Breadcrumb">
  <ol class="chiba-breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" class="chiba-breadcrumbs__link" itemprop="item">
        <span itemprop="name">{{ breadcrumb_home }}</span>
      </a>
      <meta itemprop="position" content="1" />
      <span class="chiba-breadcrumbs__separator" aria-hidden="true">/</span>
    </li>

    {%- if template.name == 'collection' and collection.handle -%}
      {%- liquid
        assign is_cycling_tag = false
        assign subcategory_title = ''
        assign current_tag_str = current_tags | join: ' ' | downcase

        if current_tag_str contains 'bioxcell'
          assign is_cycling_tag = true
          assign subcategory_title = breadcrumb_bioxcell
        elsif current_tag_str contains 'comfort'
          assign is_cycling_tag = true
          assign subcategory_title = breadcrumb_comfort
        elsif current_tag_str contains 'active'
          assign is_cycling_tag = true
          assign subcategory_title = breadcrumb_active
        elsif current_tag_str contains 'race'
          assign is_cycling_tag = true
          assign subcategory_title = breadcrumb_race
        endif
      -%}

      {%- if is_cycling_tag -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ routes.collections_url }}/chiba-gloves-germany" class="chiba-breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ breadcrumb_cycling }}</span>
          </a>
          <meta itemprop="position" content="2" />
          <span class="chiba-breadcrumbs__separator" aria-hidden="true">/</span>
        </li>
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="chiba-breadcrumbs__current" itemprop="name" aria-current="page">{{ subcategory_title }}</span>
          <meta itemprop="position" content="3" />
        </li>
      {%- elsif collection.handle == 'fitness-gloves' or collection.handle == 'training-supports' or collection.handle == 'training-belts' -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ routes.collections_url }}/chiba-gloves-germany-1" class="chiba-breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ breadcrumb_fitness }}</span>
          </a>
          <meta itemprop="position" content="2" />
          <span class="chiba-breadcrumbs__separator" aria-hidden="true">/</span>
        </li>
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="chiba-breadcrumbs__current" itemprop="name" aria-current="page">{{ collection.title }}</span>
          <meta itemprop="position" content="3" />
        </li>
      {%- elsif collection.handle == 'chiba-gloves-germany' -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="chiba-breadcrumbs__current" itemprop="name" aria-current="page">{{ breadcrumb_cycling }}</span>
          <meta itemprop="position" content="2" />
        </li>
      {%- elsif collection.handle == 'chiba-gloves-germany-1' -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="chiba-breadcrumbs__current" itemprop="name" aria-current="page">{{ breadcrumb_fitness }}</span>
          <meta itemprop="position" content="2" />
        </li>
      {%- else -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="chiba-breadcrumbs__current" itemprop="name" aria-current="page">{% if collection.handle == 'all' %}{{ breadcrumb_all }}{% else %}{{ collection.title }}{% endif %}</span>
          <meta itemprop="position" content="2" />
        </li>
      {%- endif -%}

    {%- elsif template.name == 'product' and product -%}
      {%- liquid
        assign is_cycling = false
        assign is_fitness = false
        assign prod_tags_str = product.tags | join: ' ' | downcase
        assign prod_type_str = product.type | downcase

        if prod_type_str contains 'cycling' or prod_tags_str contains 'cycling' or product.handle contains 'cycling'
          assign is_cycling = true
        elsif prod_type_str contains 'fitness' or prod_tags_str contains 'fitness' or product.handle contains 'fitness'
          assign is_fitness = true
        endif

        assign sub_title = ''
        assign sub_url = ''

        if is_cycling
          if prod_tags_str contains 'bioxcell'
            assign sub_title = breadcrumb_bioxcell
            assign sub_url = routes.all_products_collection_url | append: '/bioxcell-line'
          elsif prod_tags_str contains 'comfort'
            assign sub_title = breadcrumb_comfort
            assign sub_url = routes.all_products_collection_url | append: '/comfort-line'
          elsif prod_tags_str contains 'active'
            assign sub_title = breadcrumb_active
            assign sub_url = routes.all_products_collection_url | append: '/active-line'
          elsif prod_tags_str contains 'race'
            assign sub_title = breadcrumb_race
            assign sub_url = routes.all_products_collection_url | append: '/race-line'
          endif
        elsif is_fitness
          if prod_tags_str contains 'training-supports' or prod_tags_str contains 'supports' or product.title contains '護腕' or product.title contains '護膝' or product.title contains '護肘'
            assign sub_title = breadcrumb_supports
            assign sub_url = routes.collections_url | append: '/training-supports'
          elsif prod_tags_str contains 'training-belts' or prod_tags_str contains 'belts' or product.title contains '腰帶'
            assign sub_title = breadcrumb_belts
            assign sub_url = routes.collections_url | append: '/training-belts'
          else
            assign sub_title = breadcrumb_gloves
            assign sub_url = routes.collections_url | append: '/fitness-gloves'
          endif
        endif
      -%}

      {%- if is_cycling -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ routes.collections_url }}/chiba-gloves-germany" class="chiba-breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ breadcrumb_cycling }}</span>
          </a>
          <meta itemprop="position" content="2" />
          <span class="chiba-breadcrumbs__separator" aria-hidden="true">/</span>
        </li>
      {%- elsif is_fitness -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ routes.collections_url }}/chiba-gloves-germany-1" class="chiba-breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ breadcrumb_fitness }}</span>
          </a>
          <meta itemprop="position" content="2" />
          <span class="chiba-breadcrumbs__separator" aria-hidden="true">/</span>
        </li>
      {%- endif -%}

      {%- if sub_title != '' -%}
        <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ sub_url }}" class="chiba-breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ sub_title }}</span>
          </a>
          <meta itemprop="position" content="3" />
          <span class="chiba-breadcrumbs__separator" aria-hidden="true">/</span>
        </li>
      {%- endif -%}

      <li class="chiba-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="chiba-breadcrumbs__current" itemprop="name" aria-current="page">{{ product.title }}</span>
        <meta itemprop="position" content="{% if sub_title != '' %}4{% else %}3{% endif %}" />
      </li>
    {%- endif -%}
  </ol>
</nav>

<style>
  .chiba-breadcrumbs {
    padding-top: 14px;
    padding-bottom: 8px;
    font-size: 0.84rem;
    color: var(--color-foreground-subdued, #666);
    letter-spacing: 0.01em;
  }
  .chiba-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2px 6px;
  }
  .chiba-breadcrumbs__item {
    display: inline-flex;
    align-items: center;
  }
  .chiba-breadcrumbs__link {
    color: var(--color-foreground-subdued, #555);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .chiba-breadcrumbs__link:hover {
    color: var(--color-foreground, #000);
    text-decoration: underline;
  }
  .chiba-breadcrumbs__separator {
    margin-left: 6px;
    opacity: 0.45;
    font-size: 0.75rem;
    user-select: none;
  }
  .chiba-breadcrumbs__current {
    color: var(--color-foreground, #111);
    font-weight: 500;
  }
  @media screen and (max-width: 749px) {
    .chiba-breadcrumbs {
      font-size: 0.875rem;
      padding-top: 10px;
      line-height: 1.5;
    }
    .chiba-breadcrumbs__link,
    .chiba-breadcrumbs__current {
      padding: 4px 2px;
      min-height: 32px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>
{%- endif -%}
